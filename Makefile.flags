# R2018a 9.4.0
ifeq ("2018a","$(strip $(MATLAB_VERSION))")
  CFLAGS=-fexceptions -fPIC -fno-omit-frame-pointer -pthread
  CFLAGS+= -DMATLAB_DEFAULT_RELEASE=R2017b -DUSE_MEX_CMD -D_GNU_SOURCE -DMATLAB_MEX_FILE
  CFLAGS+= -I"$(MATLAB)/extern/include" -I"$(MATLAB)/simulink/include"
  CFLAGS_OPTIM=-O -DNDEBUG
  CFLAGS_DEBUG=-g
  LDFLAGS=-pthread -Wl,--no-undefined -Wl,-rpath-link,$(MATLAB)/bin/glnxa64 -shared  -L"$(MATLAB)/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++ -Wl,--version-script,"$(MATLAB)/extern/lib/glnxa64/c_exportsmexfileversion.map"
  LDFLAGS_OPTIM=-O
  LDFLAGS_DEBUG=-g
  MEXSRC=$(MATLAB)/extern/version/c_mexapi_version.c
endif

# R2018b 9.5.0
ifeq ("2018b","$(strip $(MATLAB_VERSION))")
  CFLAGS=-fexceptions -fPIC -fno-omit-frame-pointer -pthread
  CFLAGS+= -DMX_COMPAT_64 -DMATLAB_DEFAULT_RELEASE=R2017b -DUSE_MEX_CMD -D_GNU_SOURCE -DMATLAB_MEX_FILE
  CFLAGS+= -I"$(MATLAB)/extern/include" -I"$(MATLAB)/simulink/include"
  CFLAGS_OPTIM=-O2 -fwrapv -DNDEBUG
  CFLAGS_DEBUG=-g
  LDFLAGS=-pthread -Wl,--no-undefined -Wl,-rpath-link,$(MATLAB)/bin/glnxa64 -shared  -L"$(MATLAB)/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++ -Wl,--version-script,"$(MATLAB)/extern/lib/glnxa64/c_exportsmexfileversion.map"
  LDFLAGS_OPTIM=-O
  LDFLAGS_DEBUG=-g
  MEXSRC=$(MATLAB)/extern/version/c_mexapi_version.c
endif
